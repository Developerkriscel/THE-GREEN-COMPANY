{
  "name": "royal-green",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/apply-schema.mjs --check",
    "db:apply": "node scripts/apply-schema.mjs --shim",
    "db:test": "node scripts/apply-schema.mjs --test-only",
    "test:sponsor": "node scripts/test-sponsor-rules.mjs",
    "test:modules": "node scripts/test-module-connectivity.mjs",
    "seed:sponsor": "node scripts/seed-sponsor-demo.mjs",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "gen:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "node scripts/run-all-tests.mjs"
  },
  "comment:overrides": "This machine's Windows Application Control policy blocks Rollup's native .node binary, so Vite cannot start. Mapping rollup to its pure-WASM build sidesteps it. On a machine without that policy you can delete this overrides block and the @rollup/wasm-node devDependency for a faster build.",
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.24.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
