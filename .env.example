VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge functions (server-side only, set via `supabase secrets set`)
RESEND_API_KEY=
MAIL_FROM="Symocity <noreply@symocity.example>"
APP_BASE_URL=http://localhost:5173

# Gateway outgoing mail: sign-up codes and password reset. Any SMTP works.
# Free: Gmail (smtp.gmail.com, port 465, a Google "App Password" -- not the
# account password -- ~500 mails/day) or Brevo (smtp-relay.brevo.com, port
# 587, 300 mails/day). Unset in development prints the mail to the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# e.g. "Symocity <yourname@gmail.com>" -- Gmail sends only as the signed-in address
# MAIL_FROM is shared with the line above.

# On the live server. Without SMTP set, sign-up then refuses (503) instead
# of accepting members who can never receive their code.
NODE_ENV=production
